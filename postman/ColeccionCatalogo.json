{
	"info": {
		"_postman_id": "3f6c1a52-8d4e-4b7a-9c21-5e0b7a1d4c10",
		"name": "API Catálogo de Productos",
		"description": "Pruebas de extremo a extremo de la API REST del catálogo de productos contra la aplicación en ejecución. Requiere el entorno Catalogo-Local (variable baseUrl).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "POST crear producto",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Status 201 Created\", () => {",
							"    pm.response.to.have.status(201);",
							"});",
							"pm.test(\"Respuesta contiene id numérico\", () => {",
							"    const b = pm.response.json();",
							"    pm.expect(b).to.have.property(\"id\");",
							"    pm.collectionVariables.set(\"productoId\", b.id);",
							"});",
							"pm.test(\"Tiempo de respuesta < 500ms\", () => {",
							"    pm.expect(pm.response.responseTime).to.be.below(500);",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"nombre\": \"Teclado mecánico\",\n    \"precio\": 120.0,\n    \"categoria\": \"ELECTRONICA\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/api/productos",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"productos"
					]
				}
			},
			"response": []
		},
		{
			"name": "GET obtener producto por id",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Status 200 OK\", () => {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"El nombre coincide con el creado\", () => {",
							"    pm.expect(pm.response.json().nombre).to.eql(\"Teclado mecánico\");",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/productos/{{productoId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"productos",
						"{{productoId}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "GET listar productos por categoría",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Status 200 OK\", () => {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"La lista incluye el producto creado\", () => {",
							"    const nombres = pm.response.json().map(p => p.nombre);",
							"    pm.expect(nombres).to.include(\"Teclado mecánico\");",
							"});",
							"pm.test(\"Todos los productos son de la categoría pedida\", () => {",
							"    pm.response.json().forEach(p => pm.expect(p.categoria).to.eql(\"ELECTRONICA\"));",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/productos?categoria=ELECTRONICA",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"productos"
					],
					"query": [
						{
							"key": "categoria",
							"value": "ELECTRONICA"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "GET producto inexistente (404)",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Status 404 Not Found\", () => {",
							"    pm.response.to.have.status(404);",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/productos/99999",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"productos",
						"99999"
					]
				}
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "productoId",
			"value": ""
		}
	]
}
